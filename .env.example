# Provider credentials stay in the gateway environment. Prefer Keydeck injection.
PERSADO_API_KEY=replace-with-persado-key
MAILCHIMP_API_KEY=replace-with-mailchimp-key
MAILCHIMP_SERVER_PREFIX=us21
# Generate with: openssl rand -hex 32. Pair this local token in extension Settings.
PERSADO_PROXY_TOKEN=replace-with-random-local-pairing-token
PERSADO_GATEWAY_PORT=8788
# Optional: comma-separated extension IDs allowed as browser origins.
PERSADO_EXTENSION_IDS=
