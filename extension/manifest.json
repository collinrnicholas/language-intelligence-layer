{
  "manifest_version": 3,
  "name": "Persado Autopilot",
  "version": "0.9.0",
  "description": "Persado inside the tools you already use: score and optimize page copy, and optimize Mailchimp drafts in place with the Persado API.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://api.persado.com/*",
    "https://*.api.mailchimp.com/*",
    "http://127.0.0.1:8788/*",
    "http://localhost:8788/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Persado Autopilot \u2014 Open Side Panel",
    "default_icon": {
      "16": "public/icon16.png",
      "32": "public/icon32.png",
      "48": "public/icon48.png",
      "128": "public/icon.png"
    }
  },
  "icons": {
    "16": "public/icon16.png",
    "32": "public/icon32.png",
    "48": "public/icon48.png",
    "128": "public/icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.admin.mailchimp.com/*"
      ],
      "js": [
        "src/messages.js",
        "src/mc-overlay.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
