{
  "manifest_version": 3,
  "name": "Persado Demo",
  "version": "0.3.3",
  "description": "Persado Marketing Brief Demo — record your marketing problem, get AI-optimized compliant copy variants.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "offscreen",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Persado Demo — Open Side Panel",
    "default_icon": {
      "16": "public/icon16.png",
      "32": "public/icon32.png",
      "48": "public/icon48.png",
      "128": "public/icon.png"
    }
  },
  "icons": {
    "16": "public/icon16.png",
    "32": "public/icon32.png",
    "48": "public/icon48.png",
    "128": "public/icon.png"
  }
}
