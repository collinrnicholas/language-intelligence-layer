{
  "manifest_version": 3,
  "name": "Language Intelligence Layer",
  "version": "0.8.0",
  "description": "Scan a page's copy, score where it loses the reader, and rewrite the parts worth fixing \u2014 the language intelligence layer for page copy.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*",
    "http://127.0.0.1:8788/*",
    "http://localhost:8788/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Language Intelligence Layer \u2014 Open Side Panel",
    "default_icon": {
      "16": "public/icon16.png",
      "32": "public/icon32.png",
      "48": "public/icon48.png",
      "128": "public/icon.png"
    }
  },
  "icons": {
    "16": "public/icon16.png",
    "32": "public/icon32.png",
    "48": "public/icon48.png",
    "128": "public/icon.png"
  }
}
