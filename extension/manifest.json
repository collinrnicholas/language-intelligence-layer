{
  "manifest_version": 3,
  "name": "Persado Assist",
  "version": "0.12.0",
  "description": "Language intelligence, wherever you work. Check and improve marketing copy on websites and in Mailchimp.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8788/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Persado Assist \u2014 Open Side Panel",
    "default_icon": {
      "16": "public/icon16.png",
      "32": "public/icon32.png",
      "48": "public/icon48.png",
      "128": "public/icon.png"
    }
  },
  "icons": {
    "16": "public/icon16.png",
    "32": "public/icon32.png",
    "48": "public/icon48.png",
    "128": "public/icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.admin.mailchimp.com/*"
      ],
      "js": [
        "src/messages.js",
        "src/mc-overlay.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
